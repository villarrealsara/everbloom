# Copia este archivo con el nombre .env y escribe tus datos de MySQL.
# El archivo .env NO se sube a GitHub porque tiene la clave.
BD_HOST=localhost
BD_PUERTO=3306
BD_USUARIO=root
BD_CLAVE=escribe_aqui_tu_clave
